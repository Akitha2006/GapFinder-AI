# GapFinder AI Environment Configuration Template
# Copy this file to .env.local to configure live Supabase and Google Gemini credentials.
# If these are not provided, GapFinder AI runs seamlessly in Offline Development Mode.

# Gemini AI API Key (Official Google Gen AI SDK)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Supabase Credentials (PostgreSQL with pgvector & Supabase Auth)
# Get free project credentials at: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
