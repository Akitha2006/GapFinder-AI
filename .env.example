# ==============================================================================
# Self-Healing Cloud Infrastructure Configuration Template
# Copy this file to .env and populate with your credentials if live cloud is needed.
# NEVER commit the .env file to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Remediation Execution Mode: SIMULATION, APPROVAL_REQUIRED, AUTHORIZED_EXECUTION
# Default is strictly SIMULATION for safe operation.
REMEDIATION_MODE=SIMULATION

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite Database
DATABASE_URL=sqlite:///./backend/app.db

# LLM Configuration (Optional: system operates in rule-based fallback if unset)
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# AWS Credentials & Configuration (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Azure Credentials & Configuration (Optional)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=

# Google Cloud Platform Credentials & Configuration (Optional)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Monitoring Configuration
POLLING_INTERVAL_SECONDS=30
CPU_UTILIZATION_THRESHOLD=85.0
MEMORY_UTILIZATION_THRESHOLD=85.0
NETWORK_ANOMALY_THRESHOLD=1000000
